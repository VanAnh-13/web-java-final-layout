import { Injectable } from '@angular/core';
import { BehaviorSubject } from 'rxjs';
import { Cart, CartItem } from './models/cart.model';
import { Product } from './models/product.model';
import { environment } from '../environments/environment';
import { ProductService } from './product.service';
import { Cart, CartItem } from './models/cart.model';
import { Product } from './models/product.model';
import { environment } from '../environments/environment';

@Injectable({
    providedIn: 'root'
})
export class CartService {
    private readonly STORAGE_KEY = `${environment.storagePrefix}cart`;
    private cart: Cart = new Cart();
    private cartItemsSource = new BehaviorSubject<CartItem[]>([]);
    cartItems$ = this.cartItemsSource.asObservable();
    
    constructor() {
        this.loadCart();
        this.cartItemsSource.next(this.cart.items);
    }

    getCartItems() {
        return this.cart.items;
    }

    addToCart(product: Product, quantity: number = 1) {
        this.cart.addItem(product, quantity);
        this.cartItemsSource.next([...this.cart.items]);
        this.saveCart();
        console.log('Product added to cart via service:', product);
    }    removeItem(itemToRemove: CartItem | Product) {
        const productId = itemToRemove instanceof Product 
            ? (itemToRemove.id || itemToRemove.name) 
            : (itemToRemove.product.id || itemToRemove.product.name);
        
        if (productId) {
            this.cart.removeItem(productId);
            this.cartItemsSource.next([...this.cart.items]);
            this.saveCart();
        }
    }

    incrementItem(itemToIncrement: CartItem | Product) {
        const productId = itemToIncrement instanceof Product 
            ? (itemToIncrement.id || itemToIncrement.name) 
            : (itemToIncrement.product.id || itemToIncrement.product.name);
        
        if (productId) {
            const item = this.cart.items.find(item => (item.product.id || item.product.name) === productId);
            if (item) {
                this.cart.updateQuantity(productId, item.quantity + 1);
                this.cartItemsSource.next([...this.cart.items]);
                this.saveCart();
            }
        }
    }

    decrementItem(itemToDecrement: CartItem | Product) {
        const productId = itemToDecrement instanceof Product 
            ? (itemToDecrement.id || itemToDecrement.name) 
            : (itemToDecrement.product.id || itemToDecrement.product.name);
            
        if (productId) {
            const item = this.cart.items.find(item => (item.product.id || item.product.name) === productId);
        
        if (item) {
            if (item.quantity > 1) {
                this.cart.updateQuantity(productId, item.quantity - 1);
            } else {
                this.cart.removeItem(productId);
            }
            this.cartItemsSource.next([...this.cart.items]);
            this.saveCart();
        }
    }    getSubtotal() {
        return this.cart.totalPrice;
    }

    getEstimatedTax() {
        return this.getSubtotal() * 0.10; // Assuming 10% tax
    }

    getTotal() {
        return this.getSubtotal() + this.getEstimatedTax();
    }

    clearCart() {
        this.cart.clear();
        this.cartItemsSource.next([]);
        this.saveCart();
    }

    private saveCart() {
        try {
            localStorage.setItem(this.STORAGE_KEY, JSON.stringify(this.cart.items.map(item => ({
                productId: item.product.id,
                quantity: item.quantity
            }))));
        } catch (err) {
            console.error('Error saving cart to localStorage', err);
        }
    }

    private loadCart() {
        try {
            const savedCart = localStorage.getItem(this.STORAGE_KEY);
            if (savedCart) {
                const cartItems = JSON.parse(savedCart);
                this.cart = new Cart();
                // We need to get the actual product objects from somewhere
                // For now, we'll just use our mock products
                cartItems.forEach((item: any) => {
                    const product = this.initialCartItems.find(p => p.id === item.productId);
                    if (product) {
                        this.cart.addItem(product, item.quantity);
                    }
                });
            }
        } catch (err) {
            console.error('Error loading cart from localStorage', err);
            this.cart = new Cart();
        }
    }
}
